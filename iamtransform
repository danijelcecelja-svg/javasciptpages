<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>SFPI IAM Converter</title>
</head>
<body>
  <h2>֍ SFPI IAM Converter ֍</h2>

  <button onclick="convert()">Convert</button>
  <br><br>

  <a href="https://chatgpt.com/c/6a3d066e-ec60-83eb-859d-f03c4c247fd4" target="_blank">prompt</a>
  <br><br>

  <a href="https://github.com/danijelcecelja-svg/javasciptpages/edit/main/iam.html" target="_blank">code</a>
  <br><br>

  <h3>Input</h3>

  <textarea id="input" rows="15" cols="120" placeholder="Paste your aangeleverd data here"></textarea>

  <br><br>

  <h3>Output</h3>

  <textarea id="output" rows="15" cols="120"></textarea>

  <script>
    const DELIMITER = ";";
    const OUTPUT_DELIMITER = ";";
    const SKIP_HEADER = true;

    const OUTPUT_HEADERS = [
      "Vestigingsnummer",
      "Ondernemingsnummer",
      "Onderneming naam",
      "Integration ID",
      "Aanspreking",
      "Contact Voornaam",
      "Contact Naam",
      "Contact E-Mail",
      "Contact GSM",
      "Contact Telefoon",
      "Functietitel",
      "Specifieke lijst Contactpersonen",
      "Telefoonnummer",
      "IAM Derden Rol",
      "IAM Login",
      "MLP Technische Rol"
    ];

    function getValue(columns, columnIndex, fieldName) {

      const index = columnIndex[fieldName];

      if (index === undefined) {
        return "";
      }

      return (columns[index] || "").trim();
    }

    function padKboNumber(value) {

      const cleaned = String(value).trim();

      if (cleaned === "") {
        return "";
      }

      return cleaned.padStart(10, "0");
    }

    function convertLine(columns, columnIndex) {

      const vestigingsnummer = getValue(
        columns,
        columnIndex,
        "VESTIGING_KBO"
      );

      const ondernemingsnummer = getValue(
        columns,
        columnIndex,
        "VESTIGING_HOOFDZETEL_KBO"
      );

      const ondernemingNaam = getValue(
        columns,
        columnIndex,
        "PARTNER_VESTIGINGNAAM"
      );

      const contactEmail = getValue(
        columns,
        columnIndex,
        "CONTACT_EMAIL"
      );

      const contactVoornaam = getValue(
        columns,
        columnIndex,
        "CONTACT_VOORNAAM"
      );

      const contactNaam = getValue(
        columns,
        columnIndex,
        "CONTACT_NAAM"
      );

      const contactGsm = getValue(
        columns,
        columnIndex,
        "CONTACT_GSM"
      );

      const contactTelefoon = getValue(
        columns,
        columnIndex,
        "CONTACT_TELEFOON"
      );

      const rollenLijst = getValue(
        columns,
        columnIndex,
        "ROLLEN_LIJST"
      );

      const derdenTamGebruikersnaam = getValue(
        columns,
        columnIndex,
        "DERDEN_TAM_GEBRUIKERSNAAM"
      );

      const mlpRollenLijst = getValue(
        columns,
        columnIndex,
        "MLPROLLEN_LIJST"
      );

      const mlpRollenAantal = getValue(
        columns,
        columnIndex,
        "MLPROLLEN_AANTAL"
      );

      const paddedOndernemingsnummer =
        padKboNumber(ondernemingsnummer);

      const integrationId =
        `${paddedOndernemingsnummer} ${contactEmail}`;

      let mlpTechnischeRol = "";

      if (Number(mlpRollenAantal) > 0) {
        mlpTechnischeRol = mlpRollenLijst;
      }

      return [
        vestigingsnummer,
        ondernemingsnummer,
        ondernemingNaam,
        integrationId,
        "",
        contactVoornaam,
        contactNaam,
        contactEmail,
        contactGsm,
        contactTelefoon,
        "",
        "",
        contactTelefoon,
        rollenLijst,
        derdenTamGebruikersnaam,
        mlpTechnischeRol
      ];
    }

    function escapeCsvValue(value) {

      if (value === null || value === undefined) {
        return "";
      }

      const stringValue = String(value);

      if (
        stringValue.includes(OUTPUT_DELIMITER) ||
        stringValue.includes('"') ||
        stringValue.includes("\n") ||
        stringValue.includes("\r")
      ) {
        return `"${stringValue.replace(/"/g, '""')}"`;
      }

      return stringValue;
    }

    function convert() {

      const text = document.getElementById("input").value.trim();

      if (!text) {
        document.getElementById("output").value = "";
        return;
      }

      const lines = text.split(/\r?\n/);

      const headers = lines[0].split(DELIMITER);
      const columnIndex = {};

      headers.forEach((header, index) => {
        columnIndex[header.trim()] = index;
      });

      const outputRows = [];

      outputRows.push(OUTPUT_HEADERS);

      let start = 0;

      if (SKIP_HEADER) {
        start = 1;
      }

      for (let i = start; i < lines.length; i++) {

        if (!lines[i].trim()) {
          continue;
        }

        const columns = lines[i].split(DELIMITER);

        const outputRow = convertLine(
          columns,
          columnIndex
        );

        outputRows.push(outputRow);
      }

      const output = outputRows
        .map(row =>
          row
            .map(value => escapeCsvValue(value))
            .join(OUTPUT_DELIMITER)
        )
        .join("\n");

      document.getElementById("output").value = output;
    }
  </script>

  <div id="version">
    Last modified:
    <script>
      document.write(document.lastModified);
    </script>
  </div>

</body>
</html>
